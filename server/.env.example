# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas URI)
# Example: mongodb://localhost:27017/uniquee_food
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/uniquee_food?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://placeholder_user:placeholder_pass@cluster0.mongodb.net/uniquee_food?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=uniquee_food_super_secret_jwt_key_2026

# Stripe Payment Gateway Secret Key
# Get it from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key_here

# Frontend Application Origin
CLIENT_URL=http://localhost:5173
